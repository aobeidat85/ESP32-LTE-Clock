{
  "name": "ESP32-LTE-Clock",
  "version": "0.2.0",
  "description": "Experimental automatic LTE cell scanning and standalone UTC boot synchronization using the original ESP32 onboard antenna.",
  "keywords": [
    "esp32",
    "lte",
    "utc",
    "clock",
    "sdr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aobeidat85/ESP32-LTE-Clock.git"
  },
  "authors": [
    {
      "name": "aobeidat85",
      "url": "https://github.com/aobeidat85",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0-only",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "Esp32LteClock.h",
  "build": {
    "extraScript": "tools/platformio.py"
  },
  "export": {
    "include": [
      "src",
      "tools/platformio.py",
      "extras/sram_guard.ld",
      "examples",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md",
      "library.json",
      "library.properties"
    ]
  }
}
